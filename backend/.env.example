# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/shadowing

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Application Configuration
DEBUG=False

# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# OpenAI Whisper Configuration
# Required for video transcription with OpenAI Whisper
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Assembly AI Configuration (Optional)
# Alternative transcription service
# Get your API key from: https://www.assemblyai.com/
ASSEMBLY_AI_API_KEY=
ASSEMBLY_AI_REQUEST_TIMEOUT=300
ASSEMBLY_AI_MAX_RETRIES=3

# Transcript Cache Configuration
# Cache TTL in seconds (default: 30 days)
TRANSCRIPT_CACHE_TTL=2592000

# Google OAuth Configuration (Optional)
# For Google Sign-In integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
