# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/shadowing

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=test-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Assembly AI Configuration
ASSEMBLY_AI_API_KEY=your_api_key_here
ASSEMBLY_AI_REQUEST_TIMEOUT=300
TRANSCRIPT_CACHE_TTL=2592000
ASSEMBLY_AI_MAX_RETRIES=3

# OpenAI Whisper Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# YouTube Cookie File (optional - for bypassing bot detection)
YOUTUBE_COOKIE_FILE=/path/to/youtube/cookies.txt
